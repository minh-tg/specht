{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "gitleaks",
     "semanticVersion": "v8.0.0",
     "informationUri": "https://github.com/gitleaks/gitleaks",
     "rules": [
      {
       "id": "github-pat",
       "shortDescription": {
        "text": "Uncovered a GitHub Personal Access Token, potentially leading to unauthorized repository access and sensitive content exposure."
       }
      }
     ]
    }
   },
   "results": [
    {
     "message": {
      "text": "github-pat has detected secret for file cred.env."
     },
     "ruleId": "github-pat",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "cred.env"
        },
        "region": {
         "startLine": 1,
         "startColumn": 7,
         "endLine": 1,
         "endColumn": 46,
         "snippet": {
          "text": "placeholder-credential-one"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    },
    {
     "message": {
      "text": "github-pat has detected secret for file cred.env."
     },
     "ruleId": "github-pat",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "cred.env"
        },
        "region": {
         "startLine": 2,
         "startColumn": 9,
         "endLine": 2,
         "endColumn": 48,
         "snippet": {
          "text": "placeholder-credential-two"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    }
   ]
  }
 ]
}
