{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "gitleaks",
     "semanticVersion": "v8.0.0",
     "informationUri": "https://github.com/gitleaks/gitleaks",
     "rules": [
      {
       "id": "slack-bot-token",
       "shortDescription": {
        "text": "Identified a Slack Bot token, which may compromise bot integrations and communication channel security."
       }
      }
     ]
    }
   },
   "results": [
    {
     "message": {
      "text": "slack-bot-token has detected secret for file /src/config/app.env."
     },
     "ruleId": "slack-bot-token",
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "/src/config/app.env"
        },
        "region": {
         "startLine": 1,
         "startColumn": 17,
         "endLine": 1,
         "endColumn": 72,
         "snippet": {
          "text": "xoxb-placeholder-secret-value-01"
         }
        }
       }
      }
     ],
     "partialFingerprints": {
      "commitSha": "",
      "email": "",
      "author": "",
      "date": "",
      "commitMessage": ""
     },
     "properties": {
      "tags": []
     }
    }
   ]
  }
 ]
}
