{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "e2e-scanner",
          "version": "1.0.0",
          "rules": [
            {
              "id": "E2E-MED-002",
              "name": "OutdatedDependency",
              "shortDescription": { "text": "Outdated dependency urllib3" },
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "E2E-MED-002",
          "level": "warning",
          "message": { "text": "Outdated dependency urllib3" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "requirements.txt" },
                "region": { "startLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
