{
  "json": {
    "indentWidth": 2
  },
  "typescript": {
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": "always",
    "quoteStyle": "alwaysDouble"
  },
  "includes": [
    "frontend/src/**/*.{ts,tsx,js,jsx,json}",
    "frontend/*.{json}"
  ],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/coverage"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.19.4.wasm",
    "https://plugins.dprint.dev/typescript-0.93.3.wasm"
  ]
}
