---
import { local, repository } from "../lib/site";
import "../styles/home.css";

const scanners = [
  "Trivy",
  "Semgrep",
  "OSV-Scanner",
  "Checkov",
  "Grype",
  "Gitleaks",
  "SARIF",
  "Nuclei",
  "tfsec",
  "Dependency-Check",
  "CycloneDX / SPDX",
];
const guide = local("docs/getting-started/");
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Collect scanner reports, track findings across scans and explain what blocks a change. Specht is open-source vulnerability management you host yourself."
    />
    <meta name="theme-color" content="#191817" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Specht · Know what blocks the next merge" />
    <meta
      property="og:description"
      content="Your scanner reports, finding history and CI gates in one self-hosted application."
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={local("favicon.svg")} type="image/svg+xml" />
    <title>Specht · Know what blocks the next merge</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="masthead">
      <header class="site-header shell">
        <a class="wordmark" href={local()} aria-label="Specht home">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M13 5a9.5 9.5 0 1 0 0 19a9.5 9.5 0 1 0 0-19Zm1.5 5.5a2.2 2.2 0 1 1 0 4.4a2.2 2.2 0 1 1 0-4.4Z"
            />
            <path d="M21 12.2 31 15.4 21 18.6ZM6.5 8.2 2.5 3.5 11 5.2Z" />
          </svg>
          <span>specht</span>
        </a>
        <nav aria-label="Main navigation">
          <a href={local("docs/getting-started/")}>Docs</a>
          <a href={repository}>
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a class="header-start" href={guide}>
            Evaluate locally <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>
      <main id="main">
        <section class="hero shell" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="small-mark" aria-hidden="true"></span> SELF-HOSTED VULNERABILITY
              MANAGEMENT
            </p>
            <h1 id="hero-title">
              Know what blocks
              <br class="desktop-break" /> the next merge<span class="period">.</span>
            </h1>
            <p class="hero-description">
              Your scanners produce the reports. Specht keeps the finding history, applies your
              policy and shows the evidence behind a blocked change.
            </p>
            <div class="hero-actions">
              <a class="button button-light" href={guide}>
                Evaluate locally <span aria-hidden="true">↗</span>
              </a>
              <a class="button button-outline" href="#product">
                See the product <span aria-hidden="true">↓</span>
              </a>
            </div>
            <p class="hero-footnote">Open source · AGPL-3.0 · Experimental preview</p>
          </div>
          <div class="hero-aside" aria-hidden="true">
            <div class="signal-rule"></div>
            <div class="signal-label">REPORT IN. DECISION OUT.</div>
            <div class="signal-line">
              <span class="signal-dot"></span> Scanner report received
            </div>
            <div class="signal-line">
              <span class="signal-dot"></span> Findings matched to history
            </div>
            <div class="signal-line">
              <span class="signal-dot"></span> Change checked against policy
            </div>
            <div class="signal-result">
              <span class="gate-symbol">!</span> Blocked <span>Evidence attached</span>
            </div>
            <div class="signal-caption">Illustrative gate workflow</div>
          </div>
        </section>
        <section class="product shell" id="product" aria-labelledby="product-title">
          <div class="preview-topline">
            <h2 id="product-title">The check failed. Now you know why.</h2>
            <span class="mono">CHANGE VIEW / DEMO DATA</span>
          </div>
          <a
            class="product-frame"
            href={local("images/change-view.webp")}
            aria-label="Open full-size Specht change view screenshot"
          >
            <div class="window-bar" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span class="window-label">specht / checkout-api / change</span>
            </div>
            <img
              src={local("images/change-view.webp")}
              alt="Specht change view separates findings introduced by this change from existing debt and links each blocker to its evidence."
              width="1440"
              height="1050"
              fetchpriority="high"
            />
          </a>
          <p class="image-caption">
            Actual Specht UI with sample scanner reports. No customer data.
          </p>
        </section>
        <section class="scanner-strip shell" aria-labelledby="scanners-title">
          <div class="section-kicker">
            <h2 id="scanners-title">Keep the scanners you already run.</h2>
            <a href={local("docs/scanners/")}>
              Formats & limits <span aria-hidden="true">↗</span>
            </a>
          </div>
          <ul>
            {scanners.map((scanner) => (
              <li>{scanner}</li>
            ))}
          </ul>
        </section>
        <section class="workflow-section" aria-labelledby="workflow-title">
          <div class="shell">
            <div class="section-heading">
              <p class="eyebrow">FROM A SCAN TO A DECISION</p>
              <h2 id="workflow-title">
                A finding has a history.
                <br />A gate needs a reason.
              </h2>
              <p>
                New exposure and existing debt need different responses. Specht keeps them visible
                without treating every old finding as something your change introduced.
              </p>
            </div>
            <div class="feature-grid">
              <article class="feature-card feature-large">
                <span class="feature-index mono">01 / UNDERSTAND THE CHANGE</span>
                <h3>
                  Open the failing check.
                  <br />
                  Get the actual blockers.
                </h3>
                <p>
                  CI links to the exact report and gate decision. See what was introduced, where it
                  appears and which policy makes it block.
                </p>
                <div class="evidence-example" aria-label="Illustrative gate explanation">
                  <span class="blocked-tag">Blocks gate</span>
                  <span>Introduced by this change</span>
                  <strong>A high-severity finding meets this gate’s severity floor.</strong>
                  <span class="evidence-source mono">REPORT EVIDENCE · GATE POLICY</span>
                </div>
                <a href={local("docs/ci-gates/")}>
                  How CI gates work <span aria-hidden="true">↗</span>
                </a>
              </article>
              <article class="feature-card">
                <span class="feature-index mono">02 / KEEP THE CONTEXT</span>
                <h3>
                  Scan again.
                  <br />
                  Keep the history.
                </h3>
                <p>
                  Match findings across reports. Track open, fixed and reopened issues alongside
                  triage and reachability decisions.
                </p>
                <a href={local("docs/triage-and-waivers/")}>
                  Finding lifecycle <span aria-hidden="true">↗</span>
                </a>
              </article>
              <article class="feature-card">
                <span class="feature-index mono">03 / MAKE EXCEPTIONS EXPLICIT</span>
                <h3>
                  A waiver has
                  <br />
                  an expiry date.
                </h3>
                <p>
                  Request an exception with a reason. Keep approval separate from the request and
                  record when the exception ends.
                </p>
                <a href={local("docs/triage-and-waivers/#waivers")}>
                  Waiver approvals <span aria-hidden="true">↗</span>
                </a>
              </article>
              <article class="feature-card feature-wide">
                <div>
                  <span class="feature-index mono">04 / OWN THE INSTALLATION</span>
                  <h3>
                    One Go server.
                    <br />
                    Your Postgres database.
                  </h3>
                </div>
                <div>
                  <p>
                    The web UI ships with the server. Use local accounts or OIDC, scoped API keys
                    and per-project permissions. Configure the advisory watcher when you need it.
                  </p>
                  <a href={local("docs/self-hosting/")}>
                    Self-hosting details <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            </div>
          </div>
        </section>
        <section class="findings-section shell" aria-labelledby="findings-title">
          <div class="section-heading">
            <p class="eyebrow">WORK THE FINDINGS</p>
            <h2 id="findings-title">
              Start with what
              <br />
              needs a decision.
            </h2>
            <p>
              Jump into open findings that need triage, filter critical and high exposure, and
              distinguish severity from the issues that actually block your gate.
            </p>
          </div>
          <a
            class="secondary-frame"
            href={local("images/findings.webp")}
            aria-label="Open full-size Specht findings screenshot"
          >
            <img
              src={local("images/findings.webp")}
              alt="Specht findings list with triage shortcuts, filters, severity badges and explicit Blocks gate markers."
              width="1440"
              height="1050"
              loading="lazy"
            />
          </a>
          <p class="image-caption">
            The findings view in the current application, with synthetic scan data.
          </p>
        </section>
        <section class="start-section" aria-labelledby="start-title">
          <div class="shell start-grid">
            <div>
              <p class="eyebrow">RUN IT YOURSELF</p>
              <h2 id="start-title">
                Run Specht.
                <br />
                Upload a report.
              </h2>
              <p>
                Build from source with Docker Compose, create a project and upload a report. Run the
                server and database on your infrastructure.
              </p>
              <a class="button button-dark" href={guide}>
                Start the evaluation <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="terminal">
              <div class="terminal-heading mono">SOURCE BUILD / DOCKER COMPOSE</div>
              <pre><code>git clone https://github.com/minh-tg/specht.git
cd specht
cp deploy/.env.prod.example deploy/.env.prod</code></pre>
              <p>
                Set your secrets and setup token, then follow the quickstart to build and start the
                stack.
              </p>
              <a href={guide}>
                Open the complete commands <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <div class="shell preview-notice">
            <strong>Experimental preview.</strong> No tagged release yet. APIs, schemas and settings
            may change. Do not make Specht your only security control.
          </div>
        </section>
      </main>
      <footer class="site-footer shell">
        <a class="footer-name" href={local()}>
          specht
        </a>
        <p>Self-hosted vulnerability management.</p>
        <nav aria-label="Footer">
          <a href={local("docs/getting-started/")}>Documentation</a>
          <a href={`${repository}/issues`}>Feedback</a>
          <a href={`${repository}/blob/main/SECURITY.md`}>Security</a>
          <a href={`${repository}/blob/main/LICENSE`}>AGPL-3.0</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
