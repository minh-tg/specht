<script is:inline>
  (() => {
    const root = document.documentElement;
    const system = matchMedia("(prefers-color-scheme: dark)");
    const parse = (value) => (value === "light" || value === "dark" ? value : "auto");
    let preference = "auto";
    try {
      preference = parse(localStorage.getItem("starlight-theme"));
    } catch {}

    function apply() {
      const theme = preference === "auto" ? (system.matches ? "dark" : "light") : preference;
      root.dataset.theme = theme;
      for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
        meta.content = theme === "dark" ? "#191817" : "#f4f2ec";
      }
      const picker = document.getElementById("homepage-theme");
      if (picker) picker.value = preference;
    }
    apply();
    system.addEventListener("change", () => {
      if (preference === "auto") apply();
    });
    addEventListener("storage", (event) => {
      if (event.key !== "starlight-theme" && event.key !== null) return;
      preference = parse(event.newValue);
      apply();
    });
    document.addEventListener("DOMContentLoaded", () => {
      const picker = document.getElementById("homepage-theme");
      if (!picker) return;
      picker.value = preference;
      picker.hidden = false;
      picker.addEventListener("change", () => {
        preference = parse(picker.value);
        apply();
        try {
          localStorage.setItem("starlight-theme", preference === "auto" ? "" : preference);
        } catch {}
      });
    });
  })();
</script>
