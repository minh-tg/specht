# Server
SERVER_ADDR=:8080
# Dev-only local default. Production deployments should use sslmode=require
# or higher; do not copy this value into production configs.
DATABASE_URL=postgres://specht:specht@localhost:5432/specht?sslmode=disable
# Dev placeholder the server rejects at startup (min 32 random bytes).
# Generate one: head -c 48 /dev/urandom | base64
JWT_SECRET=dev-only-change-me
LOG_LEVEL=info
# Optional hex key (at least 16 bytes) that Gitleaks secret identities are hashed
# with. Empty keeps a generated key in the database. Generate one: openssl rand -hex 32
FINGERPRINT_KEY=
CORS_ORIGINS=http://localhost:5173
DB_MIGRATE=true
# How long startup waits for the database before giving up (0s = try once).
DB_CONNECT_TIMEOUT=30s
# Connection pool size. Keep DB_MAX_CONNS below the database's max_connections
# (100 by default in Postgres), which every client shares.
DB_MAX_CONNS=20
DB_MIN_CONNS=2
# How long a stop waits for in-flight requests. Longer than an ingest may run.
SHUTDOWN_TIMEOUT=150s
# Comma/space-separated CIDRs of reverse proxies/load balancers allowed to set
# X-Forwarded-For / X-Real-IP / X-Forwarded-Proto. Empty (default) = never
# trust forwarding headers (deploy directly; RemoteAddr stays the client).
TRUSTED_PROXIES=
# How long a package stays in the active inventory before expiry (90d).
INVENTORY_TTL=2160h
# How often the analysis/waiver expiry sweepers run (positive Go duration).
LIFECYCLE_SWEEP_INTERVAL=5m

# Threat intel (EPSS + CISA KEV), served on the finding detail read path.
# Both feeds cache for INTEL_TTL; a feed outage serves the last record, stale.
INTEL_TTL=1h
INTEL_EPSS_ENDPOINT=https://api.first.org/data/v1/epss
INTEL_KEV_ENDPOINT=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# CVE Feed Watcher (all off by default)
WATCHER_ENABLE=false
WATCHER_POLL_INTERVAL=6h
# Both endpoints must sit inside one trust boundary; an operator mirror serves
# both the batch query and the full-advisory fetch.
WATCHER_OSV_ENDPOINT=https://api.osv.dev/v1/querybatch
WATCHER_OSV_VULN_ENDPOINT=https://api.osv.dev/v1/vulns/{id}
# 0 = no batch limit.
WATCHER_BATCH_SIZE=100
# full = full-history cold start on first poll; or a Go duration to backfill since.
WATCHER_COLD_START_WINDOW=full
# Optional notifications for newly found advisories (empty = silently disabled).
# Two channels, each signed with HMAC-SHA256 when its secret is set.
WATCHER_SLACK_URL=
WATCHER_SLACK_SIGNING_SECRET=
WATCHER_WEBHOOK_URL=
# Also signs tracker deliveries below; one secret covers both outbound channels.
WATCHER_WEBHOOK_SIGNING_SECRET=

# Tracker: dispatch finding lifecycle events (created, verified_fixed,
# regression) to an external issue tracker. noop = disabled (the default).
TRACKER_PROVIDER=noop
TRACKER_BASE_URL=
TRACKER_PROJECT_ID=
TRACKER_API_TOKEN=
# TRACKER_PROVIDER=webhook fans out to these comma-separated endpoints.
WATCHER_WEBHOOK_URLS=

# SSO / OIDC (off by default). The callback requires a signed ID token and
# verifies its signature, issuer, audience, expiry, and nonce.
SSO_ENABLE=false
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Must be https; http is accepted only for a loopback host (local IdP). Use the
# exact "issuer" of <issuer>/.well-known/openid-configuration, trailing slash
# included; endpoints are read from that document.
SSO_ISSUER_URL=
SSO_REDIRECT_URI=
# Claim carrying group membership (default: groups).
SSO_GROUPS_CLAIM=
# Auto-provisioning allowlist (comma-separated email domains). Unknown IdP
# subjects are provisioned only when their email domain matches; empty
# (default) disables auto-provisioning — unknown subjects get 403.
SSO_ALLOWED_DOMAINS=
# Accept an email the IdP did not mark email_verified on a first login.
#SSO_ALLOW_UNVERIFIED_EMAIL=false
# IdP groups that grant admin to a *newly provisioned* account. An existing
# account never changes role from IdP groups.
SSO_ADMIN_GROUPS=
# Insecure compatibility escape hatch for an IdP that returns no ID token:
# identity then comes from UserInfo with no signed subject to verify.
SSO_ALLOW_USERINFO_ONLY=false

# Rate limiting (token bucket; opt-in — dev stays unlimited by default).
# Production compose enables it; see deploy/.env.prod.example.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_AUTH_RPS=1000
RATE_LIMIT_AUTH_BURST=2000
# Login and register bucket, applied even when RATE_LIMIT_ENABLED is false.
#RATE_LIMIT_LOGIN_PER_MINUTE=5
#RATE_LIMIT_LOGIN_BURST=5

# Report ingests processed at once; extra ingests wait up to 15 s, then get 503.
#INGEST_MAX_CONCURRENCY=8
# Memory all ingests in flight may charge together (64 bytes per report byte).
#INGEST_MEMORY_BUDGET=2GiB
# Open self-service POST /api/v1/auth/register (closed by default).
#REGISTRATION_ENABLED=false

# Adapter (CI/CD). API_URL and API_KEY also accept the SPECHT_-prefixed names
# below; the unprefixed name wins when both are set.
API_URL=http://localhost:8080
API_KEY=
#SPECHT_API_URL=
#SPECHT_API_KEY=
# Optional project slug; overrides the one detected in the scanner report.
SPECHT_PROJECT=
# Adapter only: repository owner recorded on the report (default: derived from
# GITHUB_REPOSITORY or CI_PROJECT_PATH).
#SPECHT_OWNER=
# Adapter only: deployment environment recorded on the report, e.g. production.
#SPECHT_ENVIRONMENT=
# Adapter only: GitHub token for the check-runs API. GITHUB_TOKEN is read first;
# GH_TOKEN is the fallback. Pass one in from the workflow; unset elsewhere.
#GITHUB_TOKEN=
#GH_TOKEN=

# MCP bridge (cmd/mcp). It reads API_URL and API_KEY above. By default it only
# exposes read-only tools usable with a project API key. The tools that change
# state (waivers_create, waivers_toggle, reachability_set) stay off because the
# agent acts on scanner-supplied text; set true to expose them deliberately.
# The admin_*, teams_list and watcher_status tools need a user session token
# in API_KEY (an API key is refused by those routes) and appear only then.
MCP_ALLOW_MUTATIONS=false

# Docker Compose
POSTGRES_PASSWORD=specht
POSTGRES_SSLMODE=disable
# Host port published for the server container (container listens on 8080).
#SERVER_PORT=8080
# Published server image tag, ghcr.io/minh-tg/specht:<tag>. Pin a release
# such as v0.1.0 for anything beyond local evaluation.
SPECHT_VERSION=latest
# Memory limit for the server container, in Docker size units (512m, 1g, 2g).
SPECHT_MEM_LIMIT=1g

# Admin elevation path (comma-separated emails). Accounts listed here are
# promoted to global admin at startup (idempotent), but only if they proved the
# address: the account first-run setup created, or one that signed in through
# SSO with a verified email. A password-registered account is never promoted
# and the server logs a warning for it; an address with no account is skipped.
# Required to administer project membership now that tenant isolation is
# enforced.
#ADMIN_EMAILS=ops@example.com

# First-run setup: while no global admin exists the server logs a one-time setup
# token. Set this (16+ characters) to choose the token instead.
#SETUP_TOKEN=
