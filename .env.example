# Server
SERVER_ADDR=:8080
DATABASE_URL=postgres://specht:specht@localhost:5432/specht?sslmode=disable
JWT_SECRET=dev-only-change-me
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
DB_MIGRATE=true
# Comma/space-separated CIDRs of reverse proxies/load balancers allowed to set
# X-Forwarded-For / X-Real-IP / X-Forwarded-Proto. Empty (default) = never
# trust forwarding headers (deploy directly; RemoteAddr stays the client).
TRUSTED_PROXIES=

# CVE Feed Watcher (all off by default)
WATCHER_ENABLE=false
# How long a package stays in the active inventory before expiry (90d).
INVENTORY_TTL=2160h
WATCHER_POLL_INTERVAL=6h
WATCHER_OSV_ENDPOINT=https://api.osv.dev/v1/querybatch
WATCHER_BATCH_SIZE=100
# full = full-history cold start on first poll; or ISO8601 date to backfill since.
WATCHER_COLD_START_WINDOW=full
# Optional Slack webhook notifications (left empty = silently disabled).
WATCHER_SLACK_URL=
WATCHER_SLACK_SIGNING_SECRET=

# Adapter (CI/CD)
API_URL=http://localhost:8080
API_KEY=

# Docker Compose
POSTGRES_PASSWORD=specht

# SSO auto-provisioning allowlist (comma-separated email domains).
# Unknown IdP subjects are provisioned only when their email domain matches;
# empty (default) disables auto-provisioning — unknown subjects get 403.
#SSO_ALLOWED_DOMAINS=example.com
