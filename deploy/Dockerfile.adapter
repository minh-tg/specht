FROM docker.io/library/golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS builder
ARG VERSION=dev
ARG COMMIT=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build \
    -trimpath \
    -buildvcs=false \
    -ldflags "-X github.com/minh-tg/specht/internal/version.Version=${VERSION} -X github.com/minh-tg/specht/internal/version.Commit=${COMMIT}" \
    -o /bin/adapter ./cmd/adapter

FROM docker.io/library/alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
# Package policy matches deploy/Dockerfile: see the note there on why Alpine
# package versions are not hard-pinned. The adapter talks HTTPS to the Specht
# API and to GitHub, so it needs the CA bundle.
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/adapter /usr/local/bin/specht-adapter
RUN addgroup -S specht && adduser -S -G specht specht
USER specht
# No HEALTHCHECK: the adapter is a one-shot CLI, there is nothing to probe.
# It is also used as a GitLab CI job image, where the runner needs a shell in
# the container and clears the entrypoint, so alpine's busybox sh stays.
ENTRYPOINT ["specht-adapter"]
