# Production environment for `docker compose --env-file deploy/.env.prod up -d`.
# Copy to deploy/.env.prod (git-ignored via .git/info/exclude; NEVER commit
# real secrets) and fill in every value. There are no safe defaults here.
#
# Generate secrets with: head -c 48 /dev/urandom | base64

# Database: used for POSTGRES_PASSWORD and the server DATABASE_URL alike.
POSTGRES_PASSWORD=CHANGE-ME-32-plus-random-chars
# The bundled Postgres container has no TLS and is reached over the private
# Compose network, so this stays `disable` for it: `require` makes the server
# fail to connect ("server does not support SSL"). Use `require` or `verify-full`
# only when you replace the bundled database with a TLS-enabled one.
POSTGRES_SSLMODE=disable

# Docker Compose
# Published server image tag, ghcr.io/minh-tg/specht:<tag>. Pin the release you
# verified with cosign. The latest tag only follows stable releases, so it does
# not exist until the first one; a release candidate needs its own tag.
SPECHT_VERSION=v0.1.0-rc.1
# Memory limit for the server container, in Docker size units.
SPECHT_MEM_LIMIT=1g

# Server
# Host port published for the server container (the container listens on 8080).
SERVER_PORT=8080
# Listen address inside the container. Compose pins this to :8080; setting it
# here has no effect.
#SERVER_ADDR=:8080
# DATABASE_URL is built by compose from POSTGRES_PASSWORD and POSTGRES_SSLMODE.
# Do not set it here; the compose file overrides it for the server container.
#DATABASE_URL=
# Run migrations at startup. Set false when running `specht migrate` as its own
# release step, and see deploy/README.md for the order.
#DB_MIGRATE=true
# Min 32 random bytes. The server refuses to start with a missing/short secret.
JWT_SECRET=CHANGE-ME-64-random-chars-min-32-bytes
LOG_LEVEL=info
# How long startup waits for Postgres to answer (0s = try once).
#DB_CONNECT_TIMEOUT=30s
# Connection pool size. Keep DB_MAX_CONNS below Postgres max_connections.
#DB_MAX_CONNS=20
#DB_MIN_CONNS=2
# How long a stop waits for in-flight requests. Keep compose stop_grace_period above it.
#SHUTDOWN_TIMEOUT=150s
# Only when the UI is hosted on a different origin than the API: exact
# origins, comma-separated, no wildcards. The bundled UI is same-origin, so
# leave this empty unless you split them.
CORS_ORIGINS=
# CIDRs of reverse proxies allowed to set X-Forwarded-* (empty = trust none).
TRUSTED_PROXIES=
# The first administrator is created in the app with the setup token the server
# logs on its first start. Set SETUP_TOKEN (16+ characters) to choose it.
#SETUP_TOKEN=
# Further global admins: accounts with these emails are promoted at startup,
# but only an account that proved the address: the one first-run setup created,
# or one that signed in through SSO with a verified email. A password-registered
# account is never promoted; the server logs a warning for it.
ADMIN_EMAILS=ops@example.com
#REGISTRATION_ENABLED=false
#INGEST_MAX_CONCURRENCY=8
#INVENTORY_TTL=2160h
# How often the analysis and waiver expiry sweepers run (Go duration).
#LIFECYCLE_SWEEP_INTERVAL=5m

# Rate limiting (sane self-host defaults; raise for large fleets).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_AUTH_RPS=1000
RATE_LIMIT_AUTH_BURST=2000
# Login and register bucket, applied even when RATE_LIMIT_ENABLED is false.
#RATE_LIMIT_LOGIN_PER_MINUTE=5
#RATE_LIMIT_LOGIN_BURST=5

# CVE Feed Watcher (opt-in continuous observation).
WATCHER_ENABLE=false
WATCHER_POLL_INTERVAL=6h
WATCHER_OSV_ENDPOINT=https://api.osv.dev/v1/querybatch
WATCHER_BATCH_SIZE=100
WATCHER_COLD_START_WINDOW=full
WATCHER_SLACK_URL=
WATCHER_SLACK_SIGNING_SECRET=
WATCHER_WEBHOOK_URL=
#WATCHER_WEBHOOK_SIGNING_SECRET=
# Full advisory fetch endpoint; {id} is replaced with the advisory id. Keep it in
# the same trust boundary as WATCHER_OSV_ENDPOINT.
#WATCHER_OSV_VULN_ENDPOINT=https://api.osv.dev/v1/vulns/{id}

# Threat intel (EPSS + CISA KEV) cache lifetime and feed endpoints.
#INTEL_TTL=1h
#INTEL_EPSS_ENDPOINT=https://api.first.org/data/v1/epss
#INTEL_KEV_ENDPOINT=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# SSO (optional). Unknown IdP subjects are provisioned only for allowlisted
# domains; empty disables auto-provisioning (unknown subjects get 403).
SSO_ENABLE=false
#SSO_CLIENT_ID=
#SSO_CLIENT_SECRET=
#SSO_ISSUER_URL=
#SSO_REDIRECT_URI=https://specht.example.com/api/v1/auth/sso/callback
#SSO_ALLOWED_DOMAINS=example.com
# Accept an email the IdP did not mark email_verified on a first login. Only for
# IdPs that never send the claim and whose emails your administrators control.
#SSO_ALLOW_UNVERIFIED_EMAIL=false
# Claim carrying group membership (default: groups).
#SSO_GROUPS_CLAIM=groups
# IdP groups that grant admin to a newly provisioned account (comma-separated).
#SSO_ADMIN_GROUPS=
# Insecure escape hatch for an IdP that returns no ID token. Leave false.
#SSO_ALLOW_USERINFO_ONLY=false

# Tracker: dispatch finding lifecycle events to an external issue tracker.
# noop (default) disables it.
#TRACKER_PROVIDER=noop
#TRACKER_BASE_URL=
#TRACKER_PROJECT_ID=
#TRACKER_API_TOKEN=
# Comma-separated webhook endpoints, used when TRACKER_PROVIDER=webhook.
#WATCHER_WEBHOOK_URLS=

# CVE details from external providers (off unless CVE_DETAIL_PROVIDERS is set).
# Only the CVE identifier leaves the server, with the server's IP address and
# User-Agent: Specht. Asked only for findings whose scan report lacks a CVSS
# v3/v4 vector, or both a CWE and a published date. Order matters: the first
# provider with the CVE answers.
#CVE_DETAIL_PROVIDERS=nvd,osv
# Optional for NVD (raises the limit from 5 to 50 requests per 30 seconds).
#CVE_DETAIL_NVD_API_KEY=
# Required when vulncheck is listed.
#CVE_DETAIL_VULNCHECK_API_KEY=
#CVE_DETAIL_TTL=24h
#CVE_DETAIL_NEGATIVE_TTL=6h
#CVE_DETAIL_TIMEOUT=10s
# Mirrors: https only; set ALLOW_PRIVATE_MIRROR for a mirror on a private address.
#CVE_DETAIL_NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
#CVE_DETAIL_ALLOW_PRIVATE_MIRROR=false
