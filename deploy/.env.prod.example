# Production environment for `docker compose --env-file deploy/.env.prod up -d`.
# Copy to deploy/.env.prod (git-ignored via .git/info/exclude; NEVER commit
# real secrets) and fill in every value. There are no safe defaults here.
#
# Generate secrets with: head -c 48 /dev/urandom | base64

# Database: used for POSTGRES_PASSWORD and the server DATABASE_URL alike.
POSTGRES_PASSWORD=CHANGE-ME-32-plus-random-chars
# Use require (or verify-full with the certificate configured). disable is only
# for the bundled localhost database; never point a remote database at it.
POSTGRES_SSLMODE=require

# Server
SERVER_PORT=8080
# Min 32 random bytes. The server refuses to start with a missing/short secret.
JWT_SECRET=CHANGE-ME-64-random-chars-min-32-bytes
LOG_LEVEL=info
# Only when the UI is hosted on a different origin than the API: exact
# origins, comma-separated, no wildcards. The bundled UI is same-origin, so
# leave this empty unless you split them.
CORS_ORIGINS=
# CIDRs of reverse proxies allowed to set X-Forwarded-* (empty = trust none).
TRUSTED_PROXIES=
# The first administrator is created in the app with the setup token the server
# logs on its first start. Set SETUP_TOKEN (16+ characters) to choose it.
#SETUP_TOKEN=
# Further global admins: existing accounts with these emails are promoted at
# startup. Signup is closed by default; create accounts through invites or
# temporarily enable REGISTRATION_ENABLED before listing them here.
ADMIN_EMAILS=ops@example.com
#REGISTRATION_ENABLED=false
#INGEST_MAX_CONCURRENCY=8
#INVENTORY_TTL=2160h

# Rate limiting (sane self-host defaults; raise for large fleets).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_AUTH_RPS=1000
RATE_LIMIT_AUTH_BURST=2000
# Login and register bucket, applied even when RATE_LIMIT_ENABLED is false.
#RATE_LIMIT_LOGIN_PER_MINUTE=5
#RATE_LIMIT_LOGIN_BURST=5

# CVE Feed Watcher (opt-in continuous observation).
WATCHER_ENABLE=false
WATCHER_POLL_INTERVAL=6h
WATCHER_OSV_ENDPOINT=https://api.osv.dev/v1/querybatch
WATCHER_BATCH_SIZE=100
WATCHER_COLD_START_WINDOW=full
WATCHER_SLACK_URL=
WATCHER_SLACK_SIGNING_SECRET=
WATCHER_WEBHOOK_URL=
#WATCHER_WEBHOOK_SIGNING_SECRET=

# Threat intel (EPSS + CISA KEV) cache lifetime and feed endpoints.
#INTEL_TTL=1h
#INTEL_EPSS_ENDPOINT=https://api.first.org/data/v1/epss
#INTEL_KEV_ENDPOINT=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# SSO (optional). Unknown IdP subjects are provisioned only for allowlisted
# domains; empty disables auto-provisioning (unknown subjects get 403).
SSO_ENABLE=false
#SSO_CLIENT_ID=
#SSO_CLIENT_SECRET=
#SSO_ISSUER_URL=
#SSO_REDIRECT_URI=https://specht.example.com/api/v1/auth/sso/callback
#SSO_ALLOWED_DOMAINS=example.com
# Accept an email the IdP did not mark email_verified on a first login. Only for
# IdPs that never send the claim and whose emails your administrators control.
#SSO_ALLOW_UNVERIFIED_EMAIL=false
