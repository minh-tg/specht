FROM golang:1.26-alpine AS builder
WORKDIR /src
# go.sum is deliberately not tracked (regenerated by the go mod tidy
# pre-commit hook), so a clean clone has no go.sum to COPY. Copy only go.mod
# and let `go mod download -mod=mod` resolve the graph and write go.sum into
# this layer, keeping both `docker build` from a clean clone and dependency
# pinning (via go.mod) reproducible.
COPY go.mod ./
ENV GOFLAGS=-mod=mod
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/server ./cmd/server

FROM alpine:3.21
# Install runtime deps without hard-pinning patch versions: pinning an exact
# Alpine package version (e.g. tzdata=2026b-r0) breaks the image build the
# moment the distro bumps the rebuild (2026b -> 2026c), which is not what a
# build should fail on. ca-certificates and tzdata are stable interfaces; the
# Go binary is what we want reproducible, and go.mod already pins that.
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /bin/server /usr/local/bin/specht
COPY --from=builder /src/migrations /migrations
EXPOSE 8080
ENTRYPOINT ["specht"]
